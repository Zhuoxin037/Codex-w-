# ============================================================
# sweetdream:equipment/tool/everlit/wisp_tick_dispatch —— 把灯灵自己的参数喂给宏
# ------------------------------------------------------------
# 【为什么要这一层】wisp_tick 是**宏函数**(要拿 $(u0)..$(u3) 拼选择器), 而宏的
#   数据源只能是"调用时 with 的那一份" —— 这里就是灯灵自己 data.zx.el。
#   (坑 129: 宏参数只能取键, 不能取列表下标 ⇒ 召唤时把 UUID 四个整数逐个
#    铺平存成 u0..u3, 不能存成数组去取 [0]。)
# 【执行者】灯灵(marker), 位置 = 它自己
# ============================================================

function sweetdream:equipment/tool/everlit/wisp_tick with entity @s data.zx.el
