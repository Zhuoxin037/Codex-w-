# ============================================================
# sweetdream:equipment/tool/bitter_cold/on_thaw —— 苦寒: 解冻瞬间的兑现
# ------------------------------------------------------------
# 【谁调用它】lib/unfreeze_one ④(执行者 = 8 格内持「苦寒」的玩家;
#   执行位置 = **刚解冻的那只生物**的位置 —— execute as 不改变执行位置)。
# 【文案】自身 8 格内的生物解除冻结状态后获得 5 秒缓慢Ⅲ和虚弱Ⅲ, 之后使其附加「渊海」。
# 【怎么找回"那只生物"】调用前给它打了 zx.bc_thaw 临时标签;
#   这里按"执行位置 + distance=..0.5"把它取回来。
#   ★ distance 还兼任"锁维度"(裸 @e 跨维度搜, 见 RULES 坑 55);
#     limit=1 只是兜底, 正常只会命中一只。
# 【为什么不用 $(target) 宏】lib/unfreeze_one 不是宏函数(它没有宏参数),
#   用标签 + 位置是最省事的做法, 且标签在调用方那个函数里立刻摘掉, 不会残留。
# ============================================================

execute as @e[tag=zx.bc_thaw,distance=..0.5,limit=1] run function sweetdream:equipment/tool/bitter_cold/thaw_victim
