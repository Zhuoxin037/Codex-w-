# ============================================================
# sweetdream:equipment/armor/rain_trace/sow —— 雨迹：维持"沿路径每 1.4 格一滴"的水迹带
# ------------------------------------------------------------
# 【谁调用它】① lib/step ①（位移已确认，每刻一次）
#             ② step_moved ⑤（刚确认位移，把"起点 → 现在"这段一次补齐）
#             ③ step_finish ①（窗口到期，补最后一滴）
# 【执行者】玩家   【执行位置】通常就是玩家脚下
# 【技能原文（lore 逐字）】
#   "自身魔力值上限 +50。自身主动技能完成实际位移后，在位移过的地方留下持续 5 秒
#    的水迹。之后对在水迹处持续停留 2 秒的生物附加「渊海」，并使其受到一次相当于
#    释放者基础攻击力 ×2 的伤害。"
#
# 【★ 本函数只做三件事：门控 / 建锚 / 交给 fill ★】
#   2026-10-18 第四次改。前三版分别死在"每刻都撒（叠 6 层）"、"每 5 刻插值
#   （往返位移横穿场地）"、"死写补点档位（一步跨太远就露缝）"。用户连续报：
#     · "水迹依旧没有铺满，且水迹之间还有重叠"
#     · "无息大约到中间就断了。横刀倒是覆盖满了"
#     · "影刃是前面一段没有"
#     · "沉锚也是后面一段没了"
#   横刀（0.25 格/刻 × 12 步 = 3 格）覆盖满 = 判据本身没写错；
#   断的都发生在"跨度大 / 时长长"的技能上 ⇒ 问题不在判据，在**补点能力**与**窗口长度**。
#   ⇒ 现在：① 间距判据与补点档位全部搬进 fill（递归铺满，任何跨度都对）；
#            ② 起点锚点与窗口续期分别是 step_moved / lib/step 的事。
#   本函数于是只剩"有没有锚"和"开跑"两句话。
#
# 【锚是谁】`zx.rt_last` —— **最新生成的那一个水迹点**（dot_spawn 末尾维护）。
#   fill 要靠它当"上一滴"的定位基准，因为 positioned 需要实体、而计分项没法
#   直接塞进坐标参数。它同时还被 dot_spawn 用来同步玩家的 zx.rt_lx/ly/lz。
# ============================================================

# ① 穿着门控（本函数每刻都会被调用，没穿就立刻退出）
execute unless items entity @s armor.feet *[minecraft:custom_data~{zx:["rain_trace"]}] run return 0

# ② 还没有任何"上一滴"（本次位移的第一滴还没撒）→ 就地撒一个，收工
#   ★ 正常走不到：step_moved 会先把起点那一摊撒在"施法刻的锚点"上。
#     这是兜底 —— 水迹点只活 100 刻，跨维度的残留窗口（比如退游戏）回来时
#     锚已经自毁了，此时至少别让"这一滴"也没有。
execute unless entity @e[tag=zx.rt_last,distance=0..,limit=1] run function sweetdream:equipment/armor/rain_trace/sow_now
execute unless entity @e[tag=zx.rt_last,distance=0..,limit=1] run return 0

# ③ 把"上一滴 → 玩家当前位置"按 1.4 格铺满（循环 / 距离判据 / 溢出钳位全在 fill）
scoreboard players set #rt_n zx.meta 16
function sweetdream:equipment/armor/rain_trace/fill
