$execute if items entity @s weapon.mainhand *[minecraft:custom_data~{zx:["palette"]}] unless items entity @s weapon.mainhand *[minecraft:item_model="palette:palette",minecraft:custom_model_data={floats:[$(frame).0f,$(c1).0f,$(c2).0f,0.0f,$(empty).0f]}] run item modify entity @s weapon.mainhand sweetdream:palette_visual
$execute if items entity @s weapon.offhand *[minecraft:custom_data~{zx:["palette"]}] unless items entity @s weapon.offhand *[minecraft:item_model="palette:palette",minecraft:custom_model_data={floats:[$(frame).0f,$(c1).0f,$(c2).0f,0.0f,$(empty).0f]}] run item modify entity @s weapon.offhand sweetdream:palette_visual
