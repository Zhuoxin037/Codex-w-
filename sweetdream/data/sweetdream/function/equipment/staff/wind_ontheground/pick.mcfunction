# ============================================================
# sweetdream:equipment/staff/wind_ontheground/pick —— 给第 n 个术阵挑一个"中心"
# ------------------------------------------------------------
# 【宏参数】zx:work wg {uuid, n}   【执行者】施法者
# 【挑法】12 格内随机一个生物, 挑完**立刻打标签冻结** ——
#   @e[sort=random] 每次求值都会重挑一个, 不冻结的话后面每一轮都会换目标,
#   那"3 轮打同一个中心"就不成立了。(流光踩过同一个坑)
# 【为什么每个术阵一个标签】zx.wg_c1 .. zx.wg_c8 各管各的,
#   这样 X 个术阵可以同时存在、互不覆盖 —— 只用一个标签的话会互相顶掉。
# ============================================================

$tag @e[tag=zx.wg_c$(n)] remove zx.wg_c$(n)
$execute at @s run tag @e[type=!#sweetdream:no_damage,distance=0.1..12,sort=random,limit=1] add zx.wg_c$(n)
