# @s = 射手(lib/find_by 反查得到), 位置 = 落点(as 不改位置)。
function sweetdream:lib/uuid
execute unless data storage zx:data self{ok:1b} run return 0
execute if data storage zx:work sfm{emp:1} run function sweetdream:equipment/staff/skyfire/meteor_emp
execute unless data storage zx:work sfm{emp:1} run function sweetdream:equipment/staff/skyfire/meteor_normal
