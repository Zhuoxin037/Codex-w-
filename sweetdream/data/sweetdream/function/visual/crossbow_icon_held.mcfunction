# Only set the visual component; preserve charged projectiles, enchantments and upgrades.
# Skip matching models to avoid refreshing item components every second.
execute if items entity @s weapon.mainhand minecraft:crossbow[minecraft:custom_data~{zx:["sculk_echo"]}] unless items entity @s weapon.mainhand *[minecraft:item_model="sweetdream:crossbow_sculk_echo"] run item modify entity @s weapon.mainhand sweetdream:crossbow_icons/sculk_echo
