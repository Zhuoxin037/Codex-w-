data modify storage zx:config oldef."begonia" set value {label:"超限·海棠",name:{"text":"超限·海棠","bold":true,"color":"dark_blue"},note:"漩涡: 范围 4格->6格(scale 8->12); 有生物死在范围内 => 漩涡增强(增强期间站在 6 格内施最大魔力值技能 +20%, 加算进 mm 通道); 结束时对 6 格内全部 ×0.25 且给中心 2 格附加「渊海」(不再清除); 冷却 -12 秒",dmg:0.0,mana:0.0,cd:0.0,lore:[{"text":"✦ 普攻","color":"gold","bold":true,"italic":false},{"text":"","italic":false,"extra":[{"text":"魔力 ","color":"gray"},{"text":"30","color":"aqua"},{"text":"   ·   ","color":"dark_gray"},{"text":"伤害 ","color":"gray"},{"text":"自身当前魔力 ×0.02","color":"yellow"}]},{"text":" ","italic":false},{"text":"每次普攻命中后都会使其轻微吸引一次其","color":"gray","italic":false},{"text":"1 格内的至多 3 个生物。","color":"gray","italic":false},{"text":" ","italic":false},{"text":"✦ 主动技能","color":"gold","bold":true,"italic":false},{"text":"","italic":false,"extra":[{"text":"魔力 ","color":"gray"},{"text":"450","color":"aqua"},{"text":"   ·   ","color":"dark_gray"},{"text":"冷却 ","color":"gray"},{"text":"120 秒","color":"yellow"}]},{"text":" ","italic":false},{"text":"使用后召唤一个术阵。之后使自身 16 格","color":"gray","italic":false},{"text":"内的最多 5 个附有「渊海」的生物以自身","color":"gray","italic":false},{"text":"为中心生成一个漩涡。漩涡每秒都会将 4","color":"gray","italic":false},{"text":"格内的全部生物拉回中心一段距离，持续","color":"gray","italic":false},{"text":"8 秒。漩涡消失后会对处于中心的生物造","color":"gray","italic":false},{"text":"成相当于释放者最大魔力值 ×0.15 的伤害。","color":"gray","italic":false},{"text":"之后清除「渊海」。","color":"gray","italic":false},{"text":" ","italic":false},{"text":"若有生物在漩涡范围内死亡，则对该漩涡","color":"gray","italic":false},{"text":"进行增强：在漩涡内使用关于最大魔力值","color":"gray","italic":false},{"text":"的技能时造成的伤害提升 20%。将漩涡范","color":"gray","italic":false},{"text":"围扩大为 6 格，且爆炸后会对漩涡内全部","color":"gray","italic":false},{"text":"生物造成相当于自身最大魔力值 ×0.25 的","color":"gray","italic":false},{"text":"伤害并使处于中心的生物附加「渊海」，","color":"gray","italic":false},{"text":"之后该技能冷却时间 -12 秒。","color":"gray","italic":false}]}
