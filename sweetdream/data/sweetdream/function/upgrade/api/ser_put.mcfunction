# ============================================================
# sweetdream:upgrade/api/ser_put —— seen 键集写入(宏 {ser})
# ------------------------------------------------------------
# 【干什么】seen."<系列名>" = 1b —— NBT 键名带变量只能走宏。
# 【调用方】ser_mark(fit 的槽位判定) / up_rebuild(先把新石头自己的系列放进去)
# ============================================================

$data modify storage zx:work seen."$(ser)" set value 1b
