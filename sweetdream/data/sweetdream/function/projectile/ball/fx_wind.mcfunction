# ============================================================
# sweetdream:projectile/ball/fx_wind —— "风" 法球的拖尾(每刻画一次)
# ------------------------------------------------------------
# 【谁调用它】ball/tick 第 ④ 步
# 【画的是什么】中心一小团淡青白色的尘(dust, 原版唯一能带颜色的粒子),
#   外面裹一层薄薄的风。
# 【想换颜色】改 dust 的 color: [红, 绿, 蓝], 每个分量 0.0 ~ 1.0。
# 【注意】dust 的参数必须写成 SNBT(dust{color:[...],scale:...}),
#   不能把数字直接跟在名字后面 —— 写错不会在加载时报错, 而是运行时报错,
#   并且会把后面所有命令一起截断。
# ============================================================

particle minecraft:dust{color:[0.72,1.0,0.86],scale:1.1} ~ ~ ~ 0.12 0.12 0.12 0 8 normal
particle minecraft:small_gust ~ ~ ~ 0.12 0.12 0.12 0.01 2 normal
