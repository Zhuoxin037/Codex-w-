execute if data storage zx:work src{id:"xiugou"} run data modify storage zx:work lore set value [{text:"✦ 主动技能",color:"gold",bold:1b,italic:0b},{text:"",italic:0b,extra:[{text:"魔力 ",color:"gray"},{text:"90",color:"aqua"},{text:"   ·   ",color:"dark_gray"},{text:"冷却 ",color:"gray"},{text:"32 秒",color:"yellow"}]},{text:" ",italic:0b},{text:"使用后在自身身前 2 格召唤“锈犬”，持",color:"gray",italic:0b},{text:"续 10 秒。锈犬每秒撕咬自身 3 格内最近",color:"gray",italic:0b},{text:"的一个生物，造成一次等同于自身基础攻",color:"gray",italic:0b},{text:"击力的伤害，最多撕咬 10 次。同一时间",color:"gray",italic:0b},{text:"只能存在一只“锈犬”，再次使用时先收",color:"gray",italic:0b},{text:"回原有的。",color:"gray",italic:0b}]

# yebu  (equipment/sword/yebu/give.mcfunction)
execute if data storage zx:work src{id:"yebu"} run data modify storage zx:work namesrc set value {text:"曳步",bold:1b,color:"gray"}
execute if data storage zx:work src{id:"yebu"} run data modify storage zx:work lore set value [{text:"✦ 被动技能",color:"gold",bold:1b,italic:0b},{text:"每次普通攻击命中后，使其获得 4 秒缓慢",color:"gray",italic:0b},{text:"Ⅰ。若其此时已处于缓慢状态，则改为使",color:"gray",italic:0b},{text:"其获得 3 秒缓慢Ⅱ。对同一个生物 4 秒",color:"gray",italic:0b},{text:"内只能升级一次。",color:"gray",italic:0b}]

# zhuzu  (equipment/armor/zhuzu/give.mcfunction)
execute if data storage zx:work src{id:"zhuzu"} run data modify storage zx:work namesrc set value {text:"驻足",bold:1b,color:"aqua"}
execute if data storage zx:work src{id:"zhuzu"} run data modify storage zx:work lore set value [{text:"✦ 被动技能",color:"gold",bold:1b,italic:0b},{text:"受到伤害后开始计时。若 1.5 秒内没有移",color:"gray",italic:0b},{text:"动，则在脚下展开半径 3 格的领域，持续",color:"gray",italic:0b},{text:"10 秒。领域内的生物每秒受到 5 点固定",color:"gray",italic:0b},{text:"伤害，并获得 1 秒缓慢Ⅰ。自身移动即收",color:"gray",italic:0b},{text:"起领域。该效果 30 秒内最多触发一次。",color:"gray",italic:0b}]
