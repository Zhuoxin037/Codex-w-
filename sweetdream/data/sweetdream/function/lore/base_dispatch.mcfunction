execute if data storage zx:work src{id:"agony"} run data modify storage zx:work lore set value [{text:"✦ 主动技能",color:"gold",bold:1b,italic:0b},{text:"",italic:0b,extra:[{text:"魔力 ",color:"gray"},{text:"600",color:"aqua"},{text:"   ·   ",color:"dark_gray"},{text:"冷却 ",color:"gray"},{text:"100 秒",color:"yellow"}]},{text:" ",italic:0b},{text:"使用后召唤一个术阵。之后使离自身最近",color:"gray",italic:0b},{text:"的一个生物每秒受到相当于释放者基础攻",color:"gray",italic:0b},{text:"击力 ×2 的伤害。若持续期间该生物死亡",color:"gray",italic:0b},{text:"则对其 2 格内的全部生物造成一次相当于",color:"gray",italic:0b},{text:"其最大生命值的伤害，之后使该效果延续",color:"gray",italic:0b},{text:"到离它最近的一个生物上。该效果持续 15",color:"gray",italic:0b},{text:"秒。",color:"gray",italic:0b}]

