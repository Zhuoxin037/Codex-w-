# ============================================================
# sweetdream:lib/ctrl_mul/fmt —— 把 #cm_pct 拼成面板要的 "×N.NN" 字符串
# ------------------------------------------------------------
# 【宏参数】zx:work cm {i, pad, f}     【出参】zx:work cm.s
#     i   = 整数部分(IntTag, 宏渲染成 "1")
#     f   = 小数部分(IntTag, 0..99; 如 20 -> "20"、5 -> "5")
#     pad = 补位字符串(StringTag: 小数部分只有一位时给 "0", 否则给 "")
# 【为什么要单独一个函数】
#   宏参数在**函数被调用那一刻**就固定了 —— lib/ctrl_mul/pct 里刚写进 cm.i / cm.f
#   的值, 在**同一个函数体内**是引用不到的(这是本包反复踩的坑, 见 with_from /
#   debug/num_row 的说明)。所以拼接必须发生在"下一次调用"里, 也就是这里。
# 【为什么不用 double 让渲染层自己转】
#   双精度下 ÷100 会有长尾(115 -> 1.1500000000000001), 而本行是要给人看的 ——
#   直接给字符串, num_row -> lib/num/plain 对字符串是原样透传(只砍 d/f 后缀)。
# 【空串没问题】pad = "" 是合法宏参数(渲染成"没有"), 面板的 s 字段一直是这么用的。
# ============================================================

$data modify storage zx:work cm.s set value "$(i).$(pad)$(f)"
