# Only update item_model on the matching held staff; keep lore, upgrades and skill data.
# Items with the correct model are skipped, so there is no repeated component refresh.
execute if items entity @s weapon.mainhand *[minecraft:custom_data~{zx:["chime"]}] unless items entity @s weapon.mainhand *[minecraft:item_model="fallendream:chime"] run item modify entity @s weapon.mainhand fallendream:staff_icons/chime
execute if items entity @s weapon.offhand *[minecraft:custom_data~{zx:["chime"]}] unless items entity @s weapon.offhand *[minecraft:item_model="fallendream:chime"] run item modify entity @s weapon.offhand fallendream:staff_icons/chime
