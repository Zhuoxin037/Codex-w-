# ============================================================
# fallendream:equipment/armor/lvshuang/on_cast —— 超限·履霜: 记一个"刚放过技能"的窗口
# ------------------------------------------------------------
# 【谁调用它】#manacore:event/cooldown_start（前置包每次技能进入冷却时抛；
#   此刻 @s 就是施法者，且技能已经真的放出来了）
# 【原文】"…自身使用位移类技能时产生的霜将直接提升为 3 层。"
# 【做法】只开一个 20 刻（1 秒）的窗口 zx.lsh_dash = 20，由 lvshuang/tick 每刻递减；
#   spawn 在这个窗口里撒的霜直接给满档 3。
# 【★ 已知近似（写在这里免得以后当 bug 查）★】冷却事件分不清"位移技能"与"原地
#   技能"，所以原地放技能后的 1 秒内正常走路撒的霜也会是 3 档。要精确判"真的位移了"
#   必须接 lib/step 那套状态机（雨迹/踏灰专用，20 刻窗口 + 逐刻比坐标）；
#   本件按 1 秒短窗口近似 —— 误差窗口很短，且方向只会偏强不会偏弱。
# 【★ 必须判超限 ★】基础档没有"档位"，这里开了窗口也没人用，但白占用一个玩家计分项；
#   直接门控掉更干净。
# ============================================================

execute unless items entity @s armor.feet *[minecraft:custom_data~{zx:["lvshuang"],ol:"lvshuang"}] run return 0

scoreboard players set @s zx.lsh_dash 20
